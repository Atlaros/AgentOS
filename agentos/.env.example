AGENTOS_DATABASE_URL=postgresql+asyncpg://agentos:agentos@127.0.0.1:5433/agentos
AGENTOS_BOOTSTRAP_TOKEN=change-me-lab-only
AGENTOS_OAUTH_SIGNING_KEY=lab-only-change-me-32b-min-key!!
AGENTOS_OAUTH_TOKEN_TTL_SECONDS=900
AGENTOS_ENV=lab
AGENTOS_AUTO_ALLOW_AMOUNT_MAX=10
# Lab signer for Stellar Testnet stretch only — never commit real secrets
# AGENTOS_STELLAR_SECRET_KEY=
# AGENTOS_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# AGENTOS_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Pollar server secret (sec_testnet_ or sec_mainnet_). A pub_ key is rejected.
# AGENTOS_POLLAR_API_KEY=
# AGENTOS_POLLAR_API_BASE=https://server.api.pollar.xyz/v3
# Trustless Work API key. Default base is testnet. This process does not sign XDR.
# AGENTOS_TRUSTLESS_WORK_API_KEY=
# AGENTOS_TRUSTLESS_WORK_API_BASE=https://dev.api.trustlesswork.com


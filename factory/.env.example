# Factory Agent OS — local env names only. Copy to .env and fill locally.
# Never commit secrets. The local Closet pilot uses the same live providers as production.

APP_ENV=local
APP_NAME=factory-agent-os

# Postgres. DATABASE_URL is admin access for migrations/seed; API runtime always
# uses a distinct role that cannot bypass RLS. Local startup provisions its
# grants from DATABASE_RUNTIME_URL; Compose needs the db hostname below.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/factory_agent_os_v2
DATABASE_RUNTIME_URL=postgresql://app_runtime:app_runtime@127.0.0.1:5434/factory_agent_os_v2
# DATABASE_RUNTIME_URL_DOCKER=postgresql://app_runtime:app_runtime@db:5432/factory_agent_os_v2
# Pytest DB tests (dedicated DB — never the live café). Host port is 5434 from docker compose.
# FACTORY_OS_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/factory_os_test
# APP_ENV=local|test loads the pilot seed and prunes SKUs missing from it.
# production migrates and leaves the catalog rows alone.

REDIS_URL=redis://localhost:6379/0

# Local AgentOS (its own process on :8080 and Postgres on 5433). Empty means Factory
# runs alone. A confirmed adapter payment posts /v1/fiat-settlements. Customer text does not.
# AGENTOS_BASE_URL=http://127.0.0.1:8080
# AGENTOS_ORGANIZATION_ID=
# AGENTOS_API_KEY=

# Factory UI
FRONTEND_ORIGIN=http://localhost:3000

# Auth — test local; supabase in hosted envs. Do not mix JWT_SECRET with service role or DB passwords.
AUTH_MODE=test
JWT_SECRET=dev-only-change-me

# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SECRET_KEY=

# WhatsApp / Meta — Closet pilot phone id is reference only; token stays local.
WHATSAPP_OUTBOUND_PROVIDER=meta
# Required when receiving WhatsApp webhooks, including local pilot traffic.
# META_WHATSAPP_VERIFY_TOKEN=
# META_WHATSAPP_APP_SECRET=
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=1192650447275054
# Approved Meta template for supplier OC (cold outreach). Empty = free-text via Fake/local.
# Meta Utility template for cold supplier OC send (must match name approved in Business Manager).
# Body text to create (category UTILITY, language es): 
#   Hola, somos {{1}}. Pedido de compra {{2}}:
#   {{3}}
#   Por favor confirmen disponibilidad y tiempo de entrega. Gracias.
# {{1}}=negocio {{2}}=nº OC {{3}}=ítems en una línea (sin saltos).
# WHATSAPP_SUPPLIER_ORDER_TEMPLATE=pedido_proveedor_oc
# WHATSAPP_SUPPLIER_ORDER_TEMPLATE_LANG=es
# OWNER_WA_NUMBERS=5917XXXXXXXX
# Public URL of THIS API, not Supabase. Closet Meta webhook (same app as v1):
# https://ventilative-obsolete-mozell.ngrok-free.dev/webhooks/whatsapp
# Local inbox without Meta: http://localhost:8000
PUBLIC_BASE_URL=https://ventilative-obsolete-mozell.ngrok-free.dev

# Model gateway — fake in CI; gemini when keys exist. Failover: MODEL_SECONDARY_PROVIDER=openrouter,groq
MODEL_PROVIDER=gemini
# GOOGLE_API_KEY=
# GEMINI_DEFAULT_MODEL_ID=
# GEMINI_COMPLEX_MODEL_ID=
# GEMINI_EMBEDDING_MODEL_ID=gemini-embedding-001
# Catalog RAG — Cohere embed-v4 (Spanish). Empty key = hashed 64-d fallback.
# COHERE_API_KEY=
# COHERE_EMBED_MODEL_ID=embed-v4.0
# COHERE_EMBED_DIMS=1024
# MODEL_SECONDARY_PROVIDER=openrouter,groq
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL_ID=
# GROQ_API_KEY=
# GROQ_MODEL_ID=
# MODEL_TIMEOUT_S=8

# Observability
OBSERVABILITY_PROVIDER=noop
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Required for owner API routes in every environment.
# OWNER_DASHBOARD_USERNAME=pilot.owner@agentos.local
# OWNER_DASHBOARD_TOKEN=
# PUBLIC_SIGNUP_ENABLED=false
# PUBLIC_SIGNUP_MAX_PER_WINDOW=5
# PUBLIC_SIGNUP_WINDOW_S=3600
# TRUSTED_PROXY_HOPS=0
# API_INTERNAL_URL=http://localhost:8000 (host Next.js) or http://api:8000 (Compose)

# Payments — adapter behind a provider; Baneco is the Closet pilot, not the domain.
# Live pilot: missing credentials/provider must stop startup; tests inject fake adapters.
QR_PROVIDER=baneco
BANK_TX_PROVIDER=baneco
ENABLE_LIVE_PAYMENTS=true
# BANECO_API_BASE_URL=https://apimkt.baneco.com.bo/ApiGateway/
# BANECO_USERNAME=
# BANECO_PASSWORD=
# BANECO_AES_KEY=
# BANECO_ACCOUNT_CREDIT=
# BANECO_QR_DUE_HOURS=24
# Optional shared secret for POST /webhooks/payments/baneco (Baneco notifyPaymentQR).
# BANECO_NOTIFY_SHARED_SECRET=

# Closet synthetic pilot tenant (not LLM/client authority).
PILOT_TENANT_ID=dddddddd-dddd-dddd-dddd-dddddddddddd
# dummy = pytest 13 SKUs. closet = Excel Authentic Closet (tests / load_pilot_catalog).
# cafe = live pilot cafeteria (catalog_cafe.json + shop_cafe.json). Same tenant UUID.
CATALOG_SEED=cafe

# Hours of silence before Adri reopens with greet + ¿continuar o buscar otra?
# CONVERSATION_IDLE_HOURS=4

RUNTIME_KILL_SWITCH=false
LOG_LEVEL=INFO
